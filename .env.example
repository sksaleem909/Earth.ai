# TerraVision AI Environment Configuration
# ==========================================
# Copy this file to .env and fill in your values

# Database
# For SQLite (default, no Docker needed):
DATABASE_URL=sqlite+aiosqlite:///./terravision.db
# For PostgreSQL + PostGIS (via Docker):
# DATABASE_URL=postgresql+asyncpg://terravision:terravision_secret@localhost:5432/terravision

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# AI API Keys (optional — mock data used when not provided)
GEMINI_API_KEY=

# External Data APIs (optional — mock data used when not provided)
OPENAQ_API_KEY=
OPEN_METEO_API=https://api.open-meteo.com/v1
NOMINATIM_API=https://nominatim.openstreetmap.org
OVERPASS_API=https://overpass-api.de/api
OSRM_API=https://router.project-osrm.org

# Application
APP_NAME=TerraVision AI
APP_VERSION=1.0.0
DEBUG=true
